# 開発用の設定例。秘密情報は書かない。本番は Secret Manager から読む。
PORT=8080
# 開発時にログインしたことにする社員のメール（本番では IAP ヘッダーを使う）
DEV_USER_EMAIL=ichitsuya@example.com
# Teams 変更通知の clientState（本番は Secret Manager）
TEAMS_CLIENT_STATE=dev-client-state
# 自社テナント ID（送信者分類に使う）
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000
# 通知先（未設定ならモック通知＝ログに記録のみ）
TEAMS_WORKFLOWS_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL=
# スナップショットの保存先（開発のみ）
DATA_FILE=./data/dev-store.json
